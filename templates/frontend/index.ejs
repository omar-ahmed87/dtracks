      <div class="impact-stat-item">
        <span class="material-symbols-rounded impact-icon star">star</span>
        <div class="impact-text">
          <h3 class="stat-number-wrapper" dir="ltr">
            <span class="stat-number" data-count="4.9" data-decimal="1"
