          <p data-i18n="stat_avg_rating">Average Rating</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Homepage CTA Box -->
<section
  class="homepage-cta-section"
  style="
    background: transparent;
    position: relative;
    z-index: 10;
    padding: 0 24px;
    margin-bottom: 40px;
  "
>
  <div class="section-container">
    <div class="footer-cta-box fade-in-up">
      <div class="cta-content">
        <h3 data-i18n="cta_title">Ready to start your journey?</h3>
        <p data-i18n="cta_desc">
          Join thousands of learners and start building your future today.
        </p>
      </div>
      <a href="/register" class="btn btn-primary cta-btn">
        <span data-i18n="btn_get_started">Get Started</span>
        <span class="material-symbols-rounded" dir="auto">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

