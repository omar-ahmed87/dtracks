          </h3>
          <p data-i18n="stat_students">Students</p>
        </div>
      </div>

      <div class="impact-stat-item">
        <span class="material-symbols-rounded impact-icon">work</span>
        <div class="impact-text">
          <h3 class="stat-number-wrapper" dir="ltr">
            <span class="stat-number" id="dynamic-course-count" data-count="320"
              >320</span
            ><span class="stat-suffix">+</span>
          </h3>
          <p data-i18n="stat_courses">Courses</p>
        </div>
      </div>

      <div class="impact-stat-item">
        <span class="material-symbols-rounded impact-icon">ads_click</span>
        <div class="impact-text">
          <h3 class="stat-number-wrapper" dir="ltr">
            <span class="stat-number" data-count="98">98</span
            ><span class="stat-suffix">%</span>
          </h3>
          <p data-i18n="stat_completion">Completion Rate</p>
        </div>
