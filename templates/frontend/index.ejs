<!-- Hero Section -->
<section id="home" class="hero hero-minimalist">
  <div class="hero-container">
    <div class="hero-content reveal-up">
      <h1 id="hero-title" class="hero-title-gradient">
        <span data-i18n="hero_title_1">Don't Just Learn Skills</span>
        <br />
        <span data-i18n="hero_title_2">Prove Them.</span>
      </h1>
      <p data-i18n="hero_desc" class="hero-subtitle">
        Project-based learning in tech, design, and languages. Build real-world
        skills and accelerate your career today.
      </p>

      <div class="hero-buttons hero-buttons-pair">
        <a
          href="/register"
          class="btn btn-primary btn-lg hero-btn-main"
          style="
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
          "
        >
          <span data-i18n="btn_get_started">Get Started</span>
          <span class="material-symbols-rounded">rocket_launch</span>
        </a>
        <a
          href="#courses"
          class="btn btn-outline btn-lg hero-btn-secondary"
          style="
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
          "
        >
          <span data-i18n="btn_browse_courses">Browse Courses</span>
        </a>
      </div>

      <div class="trust-stats-minimal">
        <div class="stat-pill">
          <span class="material-symbols-rounded star">star</span>
          <span class="pill-text"
            ><strong class="stat-pill-num" data-count="4.8" data-decimal="1"
              >4.8</strong
            >
            <span data-i18n="stat_avg_rating">Average Rating</span></span
          >
        </div>
        <div class="stat-pill">
          <span class="material-symbols-rounded" style="color: var(--primary)"
            >group</span
          >
          <span class="pill-text"
            ><strong class="stat-pill-num" data-count="725" data-prefix="+"
              >+725</strong
            >
            <span data-i18n="stat_students">Students</span></span
          >
        </div>
        <div class="stat-pill">
          <span class="material-symbols-rounded" style="color: var(--secondary)"
            >library_books</span
          >
          <span class="pill-text"
            ><strong
              class="stat-pill-num"
              id="dynamic-course-count-pill"
              data-count="5"
              data-prefix="+"
              >+5</strong
            >
            <span data-i18n="stat_courses">Courses</span></span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Featured Courses -->
<section id="courses" class="featured-courses section-padding full-width-bg">
  <div class="section-container">
    <div class="section-header fade-in-up">
      <h2 data-i18n="section_courses_title">Featured Courses</h2>
      <p data-i18n="section_courses_desc">
        Start with our most popular and highly-rated courses chosen by thousands
        of learners.
      </p>
    </div>
    <div class="tracks-grid" id="courses-container" data-featured>
      <!-- Dynamic courses injected by main.js -->
    </div>
    <div class="courses-quick-action fade-in-up">
      <p>
        <span data-i18n="already_enrolled">Already enrolled in a course?</span>
        <a href="/payment" class="payment-link" data-i18n="nav_payment_link"
          >Confirm payment here</a
        >
      </p>
    </div>
  </div>
</section>

<!-- How E-Tracks Works (Timeline) -->
<section
  id="registration-steps"
  class="registration-steps section-padding full-width-bg"
>
  <div class="section-container">
    <div class="section-header text-center fade-in-up">
      <h2 data-i18n="section_how_title">How E-Tracks Works</h2>
      <p data-i18n="section_how_desc">
        Simple steps to start your learning journey
      </p>
    </div>

    <div class="timeline-container">
      <div class="timeline-line-dashed"></div>
      <div class="timeline-steps">
        <!-- Step 1 -->
        <div class="timeline-step fade-in-up">
          <div class="timeline-icon-wrapper">
            <div class="timeline-badge">01</div>
            <span class="material-symbols-rounded">person</span>
          </div>
          <div class="timeline-text">
            <h3 data-i18n="step_1_reg_title">Create Account</h3>
            <p data-i18n="step_1_reg_desc">
              Sign up in minutes and get started
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="timeline-step fade-in-up delay-1">
          <div class="timeline-icon-wrapper">
            <div class="timeline-badge">02</div>
            <span class="material-symbols-rounded">play_lesson</span>
          </div>
          <div class="timeline-text">
            <h3 data-i18n="step_2_reg_title">Choose Course</h3>
            <p data-i18n="step_2_reg_desc">
              Browse courses and select what interests you
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="timeline-step fade-in-up delay-2">
          <div class="timeline-icon-wrapper">
            <div class="timeline-badge">03</div>
            <span class="material-symbols-rounded">school</span>
          </div>
          <div class="timeline-text">
            <h3 data-i18n="step_3_reg_title">Make Payment</h3>
            <p data-i18n="step_3_reg_desc">
              Secure payment via multiple options
            </p>
          </div>
        </div>

        <!-- Step 4 -->
        <div class="timeline-step fade-in-up delay-3">
          <div class="timeline-icon-wrapper">
            <div class="timeline-badge">04</div>
            <span class="material-symbols-rounded">schedule</span>
          </div>
          <div class="timeline-text">
            <h3 data-i18n="step_4_reg_title">Start Learning</h3>
            <p data-i18n="step_4_reg_desc">
              Access your course and learn at your pace
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why Choose E-Tracks? (Bento Grid) -->
<section id="why-us" class="why-us-section section-padding bg-light">
  <div class="section-container">
    <div class="section-header text-center fade-in-up">
      <h2 data-i18n="section_why_title">Why Choose D-Tracks?</h2>
    </div>

    <div class="bento-image-grid">
      <!-- Large Left Card -->
      <div class="bento-card bento-large fade-in-up">
        <div class="bento-content">
          <h3 data-i18n="feat_pace_title">Learn at Your Pace</h3>
          <p data-i18n="feat_pace_desc">
            Access courses anytime, anywhere. Learn on your schedule.
          </p>
        </div>
        <img
          src="/assets/bento_student.png"
          alt="Student learning"
          class="bento-illustration bento-img-student"
        />
        <div class="bento-arrow">
          <span class="material-symbols-rounded">chevron_right</span>
        </div>
      </div>

      <!-- Middle Column -->
      <div class="bento-col">
        <!-- Top Middle -->
        <div class="bento-card bento-small fade-in-up delay-1">
          <div class="bento-content">
            <h3 data-i18n="feat_expert_title">Expert Instructors</h3>
            <p data-i18n="feat_expert_desc">
              Learn from industry experts with real experience.
            </p>
          </div>
          <img
            src="/assets/bento_medal.png"
            alt="Expert badge"
            class="bento-illustration bento-img-medal"
          />
          <div class="bento-arrow">
            <span class="material-symbols-rounded">chevron_right</span>
          </div>
        </div>

        <!-- Bottom Middle -->
        <div class="bento-card bento-small fade-in-up delay-2">
          <div class="bento-content">
            <h3 data-i18n="feat_community_title">Community Support</h3>
            <p data-i18n="feat_community_desc">
              Join a community of learners and grow together.
            </p>
          </div>
          <div class="bento-illustration bento-avatars-group">
            <img
              src="/assets/bento_avatars.png"
              alt="Community avatars"
              class="bento-img-avatars"
            />
            <div class="avatar-count">+2K</div>
          </div>
          <div class="bento-arrow">
            <span class="material-symbols-rounded">chevron_right</span>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="bento-col">
        <!-- Top Right -->
        <div class="bento-card bento-small fade-in-up delay-1">
          <div class="bento-content">
            <h3 data-i18n="feat_track_title">Track Progress</h3>
            <p data-i18n="feat_track_desc">
              Monitor your progress and achievements in real-time.
            </p>
          </div>
          <img
            src="/assets/bento_chart.png"
            alt="Progress chart"
            class="bento-illustration bento-img-chart"
          />
          <div class="bento-arrow">
            <span class="material-symbols-rounded">chevron_right</span>
          </div>
        </div>

        <!-- Bottom Right -->
        <div class="bento-card bento-small fade-in-up delay-2">
          <div class="bento-content">
            <h3 data-i18n="feat_cert_title">Certificate</h3>
            <p data-i18n="feat_cert_desc">
              Earn certificates and boost your career opportunities.
            </p>
          </div>
          <img
            src="/assets/bento_certificate.png"
            alt="Certificate"
            class="bento-illustration bento-img-cert"
          />
          <div class="bento-arrow">
            <span class="material-symbols-rounded">chevron_right</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Our Impact Stats Banner -->
