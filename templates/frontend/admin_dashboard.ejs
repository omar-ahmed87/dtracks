<!-- ═══ CMS Lesson Modal (Add/Edit) ═══ -->
<div class="admin-modal-overlay" id="cmsLessonModal">
  <div class="admin-modal" style="max-width: 600px;">
    <div class="admin-modal-header">
      <h3 id="cms-lesson-modal-title">Add Lesson</h3>
      <button class="btn-icon" data-action="close-modal" data-target="cmsLessonModal">
        <span class="material-symbols-rounded">close</span>
      </button>
    </div>
    <div class="admin-modal-body">
      <input type="hidden" id="cms-lesson-module-index">
      <input type="hidden" id="cms-lesson-index">
      <div class="form-row">
        <div class="form-group flex-1">
          <label class="form-label">Lesson Title (English)</label>
          <input type="text" id="cms-lesson-title-en" class="form-control" placeholder="e.g. Lesson 1: Overview" required>
        </div>
        <div class="form-group flex-1">
          <label class="form-label">Lesson Title (Arabic)</label>
          <input type="text" id="cms-lesson-title-ar" class="form-control" placeholder="e.g. الدرس 1: نظرة عامة" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group flex-1">
          <label class="form-label">Type</label>
          <select id="cms-lesson-type" class="form-control">
            <option value="video">Video</option>
            <option value="quiz">Quiz</option>
            <option value="project">Project / Task</option>
            <option value="pdf">PDF Read</option>
            <option value="code">Coding Lab</option>
            <option value="link">External Link</option>
          </select>
        </div>
        <div class="form-group flex-1">
          <label class="form-label">Duration Info</label>
          <input type="text" id="cms-lesson-duration" class="form-control" placeholder="e.g. 10m or 15 Questions">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Video Embed / Link URL (YouTube)</label>
        <input type="url" id="cms-lesson-video-url" class="form-control" placeholder="https://www.youtube.com/watch?v=...">
      </div>
      <div class="form-group">
        <label class="form-label">Attachment / PDF Link URL</label>
        <input type="url" id="cms-lesson-attachment" class="form-control" placeholder="https://...">
      </div>
      <div class="form-row">
        <div class="form-group flex-1" style="display:flex; align-items:center; gap:8px;">
          <input type="checkbox" id="cms-lesson-published" checked>
          <label for="cms-lesson-published" class="form-label" style="margin:0;">Published / Active</label>
        </div>
        <div class="form-group flex-1" style="display:flex; align-items:center; gap:8px;">
          <input type="checkbox" id="cms-lesson-visible" checked>
          <label for="cms-lesson-visible" class="form-label" style="margin:0;">Visible to Students</label>
        </div>
      </div>
    </div>
    <div class="admin-modal-footer">
      <button class="btn btn-outline" data-action="close-modal" data-target="cmsLessonModal">Cancel</button>
      <button class="btn btn-primary" id="btn-cms-save-lesson">Save Lesson</button>
    </div>
  </div>
</div>